---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section aria-labelledby="catalog-heading">
      <h2 id="catalog-heading" class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
        <fieldset>
          <legend class="mb-4 text-lg font-medium text-slate-100">Filter games</legend>
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <span class="mb-3 block text-sm font-medium text-slate-200">Categories</span>
              <div class="grid gap-2 sm:grid-cols-2">
                {categories.map((category) => (
                  <label class="flex items-center gap-2 text-sm text-slate-300">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      data-testid={`category-filter-${category.id}`}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </div>
            <div>
              <label for="publisher-filter" class="mb-3 block text-sm font-medium text-slate-200">Publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                data-testid="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>
          </div>
          <div class="mt-6 flex items-center gap-4">
            <button
              type="button"
              data-testid="clear-filters"
              class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              Clear filters
            </button>
            <p class="text-sm text-slate-300" data-testid="filter-results" role="status" aria-live="polite"></p>
          </div>
        </fieldset>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty-state" role="status" aria-live="polite">
        <EmptyState text="No games match the selected filters." />
      </div>
    </section>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const result = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');

  if (form && result && emptyState && clearButton) {
    const categories = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisher = form.querySelector<HTMLSelectElement>('select[name="publisher"]');
    let initialCategoryParams: string[] = [];

    const applyFilters = (updateUrl: boolean): void => {
      const selectedCategories = categories.filter((input) => input.checked).map((input) => input.value);
      const categoryFilters = selectedCategories.length > 0 ? selectedCategories : initialCategoryParams;
      const selectedPublisher = publisher?.value ?? '';
      const visibleCards = cards.filter((card) => {
        const categoryMatches = categoryFilters.length === 0 || categoryFilters.includes(card.dataset.categoryId ?? '');
        const publisherMatches = selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const visible = categoryMatches && publisherMatches;
        card.classList.toggle('hidden', !visible);
        return visible;
      });

      result.textContent = `${visibleCards.length} ${visibleCards.length === 1 ? 'game' : 'games'} shown`;
      emptyState.classList.toggle('hidden', visibleCards.length > 0);

      if (updateUrl) {
        const params = new URLSearchParams();
        categoryFilters.forEach((category) => params.append('category', category));
        if (selectedPublisher) params.set('publisher', selectedPublisher);
        const query = params.toString();
        history.replaceState(null, '', query ? `${window.location.pathname}?${query}` : window.location.pathname);
      }
    };

    const params = new URLSearchParams(window.location.search);
    initialCategoryParams = params.getAll('category');
    const initialCategories = new Set(initialCategoryParams);
    categories.forEach((input) => {
      input.checked = initialCategories.has(input.value);
      input.addEventListener('change', () => {
        initialCategoryParams = [];
        applyFilters(true);
      });
    });
    if (publisher) {
      publisher.value = params.get('publisher') ?? '';
      publisher.addEventListener('change', () => applyFilters(true));
    }
    clearButton.addEventListener('click', () => {
      categories.forEach((input) => { input.checked = false; });
      initialCategoryParams = [];
      if (publisher) publisher.value = '';
      applyFilters(true);
    });
    applyFilters(false);
  }
</script>
